# ============================================================================
# EZDRYCO - FRONTEND ENVIRONMENT (template — copy to .env)
# Only VITE_-prefixed, client-safe values belong here.
# NEVER put SUPABASE_SERVICE_KEY or SUPABASE_SECRET_KEY (backend-only) here.
# ============================================================================

VITE_BRAND_NAME=EzDry

# Backend API base URL (the app calls <base>/api/...)
VITE_API_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Supabase public/client-safe values only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
